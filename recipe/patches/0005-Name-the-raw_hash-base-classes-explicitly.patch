From: Mark Harfouche <mark.harfouche@gmail.com>
Subject: [PATCH] Name the raw_hash_map/raw_hash_set base classes explicitly

Follow-up to 0004.  The four hash containers alias their base class
through the derived class's injected-class-name:

    using Base = typename flat_hash_map::raw_hash_map;

MSVC does not resolve that in the host code nvcc 13.4 generates.  With
the friend declarations in absl/hash fixed by 0004, CUDA translation
units on Windows that include a hash container still fail with

    absl/container/flat_hash_map.h(141): error C2248:
      'absl::lts_20260526::container_internal::raw_hash_map<T>::Hash':
      cannot access private typedef declared in class
      'absl::lts_20260526::container_internal::raw_hash_map<T>'
    absl/container/flat_hash_map.h(141): error C2248:
      'absl::lts_20260526::container_internal::raw_hash_map<T>::Eq':
      cannot access private typedef declared in class
      'absl::lts_20260526::container_internal::raw_hash_map<T>'

Observed in onnxruntime-feedstock with libabseil 20260526.0, cuda-nvcc
13.4.92 and vs2022_win-64 19.44.35207, with only the two 0004 lines
applied to the headers:
https://github.com/conda-forge/onnxruntime-feedstock/actions/runs/37306309009/job/111750712123

Spell the base type out instead.  That requires renaming the class
template's Hash/Eq parameters, and node_hash_map/node_hash_set's Alloc
parameter: raw_hash_map and raw_hash_set declare private typedefs named
Hash, Eq and Alloc.  MSVC looks unqualified names up in dependent base
classes, so inside the derived class body those private typedefs hide
template parameters of the same name, and the spelled-out base would
pick them up and fail with the same C2248.  (flat_hash_map and
flat_hash_set call their third parameter Allocator, which does not
collide.)  The parameters are not referenced anywhere else inside these
class bodies, and template parameter names are not part of any mangled
name, so this changes no behaviour and no ABI.

Unlike 0004, onnxruntime does not carry this change for the abseil it
vendors, and there is no upstream abseil report for it yet.
---
diff --git a/absl/container/flat_hash_map.h b/absl/container/flat_hash_map.h
index f8c3ba7..2a1e5cb 100644
--- a/absl/container/flat_hash_map.h
+++ b/absl/container/flat_hash_map.h
@@ -138,16 +138,19 @@ struct FlatHashMapPolicy;
 //   }
 template <
     class K, class V,
-    class Hash =
+    class AbslHashT =
         typename container_internal::FlatHashMapPolicy<K, V>::DefaultHash,
-    class Eq = typename container_internal::FlatHashMapPolicy<K, V>::DefaultEq,
+    class AbslEqT =
+        typename container_internal::FlatHashMapPolicy<K, V>::DefaultEq,
     class Allocator =
         typename container_internal::FlatHashMapPolicy<K, V>::DefaultAlloc>
 class ABSL_ATTRIBUTE_OWNER flat_hash_map
     : public absl::container_internal::InstantiateRawHashMap<
-          absl::container_internal::FlatHashMapPolicy<K, V>, Hash, Eq,
+          absl::container_internal::FlatHashMapPolicy<K, V>, AbslHashT, AbslEqT,
           Allocator>::type {
-  using Base = typename flat_hash_map::raw_hash_map;
+  using Base = typename absl::container_internal::InstantiateRawHashMap<
+      absl::container_internal::FlatHashMapPolicy<K, V>, AbslHashT, AbslEqT,
+      Allocator>::type;
 
  public:
   // Constructors and Assignment Operators
diff --git a/absl/container/flat_hash_set.h b/absl/container/flat_hash_set.h
index bd24dde..81a1ffc 100644
--- a/absl/container/flat_hash_set.h
+++ b/absl/container/flat_hash_set.h
@@ -132,15 +132,18 @@ struct FlatHashSetPolicy;
 //   }
 template <
     class T,
-    class Hash = typename container_internal::FlatHashSetPolicy<T>::DefaultHash,
-    class Eq = typename container_internal::FlatHashSetPolicy<T>::DefaultEq,
+    class AbslHashT =
+        typename container_internal::FlatHashSetPolicy<T>::DefaultHash,
+    class AbslEqT = typename container_internal::FlatHashSetPolicy<T>::DefaultEq,
     class Allocator =
         typename container_internal::FlatHashSetPolicy<T>::DefaultAlloc>
 class ABSL_ATTRIBUTE_OWNER flat_hash_set
     : public absl::container_internal::InstantiateRawHashSet<
-          absl::container_internal::FlatHashSetPolicy<T>, Hash, Eq,
+          absl::container_internal::FlatHashSetPolicy<T>, AbslHashT, AbslEqT,
           Allocator>::type {
-  using Base = typename flat_hash_set::raw_hash_set;
+  using Base = typename absl::container_internal::InstantiateRawHashSet<
+      absl::container_internal::FlatHashSetPolicy<T>, AbslHashT, AbslEqT,
+      Allocator>::type;
 
  public:
   // Constructors and Assignment Operators
diff --git a/absl/container/node_hash_map.h b/absl/container/node_hash_map.h
index d58feed..a879a63 100644
--- a/absl/container/node_hash_map.h
+++ b/absl/container/node_hash_map.h
@@ -124,17 +124,19 @@ class NodeHashMapPolicy;
 //   }
 template <
     class Key, class Value,
-    class Hash =
+    class AbslHashT =
         typename container_internal::NodeHashMapPolicy<Key, Value>::DefaultHash,
-    class Eq =
+    class AbslEqT =
         typename container_internal::NodeHashMapPolicy<Key, Value>::DefaultEq,
-    class Alloc = typename container_internal::NodeHashMapPolicy<
+    class AbslAllocT = typename container_internal::NodeHashMapPolicy<
         Key, Value>::DefaultAlloc>
 class ABSL_ATTRIBUTE_OWNER node_hash_map
     : public absl::container_internal::InstantiateRawHashMap<
-          absl::container_internal::NodeHashMapPolicy<Key, Value>, Hash, Eq,
-          Alloc>::type {
-  using Base = typename node_hash_map::raw_hash_map;
+          absl::container_internal::NodeHashMapPolicy<Key, Value>, AbslHashT,
+          AbslEqT, AbslAllocT>::type {
+  using Base = typename absl::container_internal::InstantiateRawHashMap<
+      absl::container_internal::NodeHashMapPolicy<Key, Value>, AbslHashT,
+      AbslEqT, AbslAllocT>::type;
 
  public:
   // Constructors and Assignment Operators
diff --git a/absl/container/node_hash_set.h b/absl/container/node_hash_set.h
index 55568b7..0f69d17 100644
--- a/absl/container/node_hash_set.h
+++ b/absl/container/node_hash_set.h
@@ -120,15 +120,18 @@ struct NodeHashSetPolicy;
 //   }
 template <
     class T,
-    class Hash = typename container_internal::NodeHashSetPolicy<T>::DefaultHash,
-    class Eq = typename container_internal::NodeHashSetPolicy<T>::DefaultEq,
-    class Alloc =
+    class AbslHashT =
+        typename container_internal::NodeHashSetPolicy<T>::DefaultHash,
+    class AbslEqT = typename container_internal::NodeHashSetPolicy<T>::DefaultEq,
+    class AbslAllocT =
         typename container_internal::NodeHashSetPolicy<T>::DefaultAlloc>
 class ABSL_ATTRIBUTE_OWNER node_hash_set
     : public absl::container_internal::InstantiateRawHashSet<
-          absl::container_internal::NodeHashSetPolicy<T>, Hash, Eq,
-          Alloc>::type {
-  using Base = typename node_hash_set::raw_hash_set;
+          absl::container_internal::NodeHashSetPolicy<T>, AbslHashT, AbslEqT,
+          AbslAllocT>::type {
+  using Base = typename absl::container_internal::InstantiateRawHashSet<
+      absl::container_internal::NodeHashSetPolicy<T>, AbslHashT, AbslEqT,
+      AbslAllocT>::type;
 
  public:
   // Constructors and Assignment Operators
